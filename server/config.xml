<!-- Server settings for a small box (4 to 8 GB). Installed by setup.sh as
     /etc/clickhouse-server/config.d/headlinesearch.xml. Which interfaces the
     server listens on is in config.d/listen.xml, which setup.sh writes:
     localhost only behind the Tunnel, every interface when port 8123 is
     open to Cloudflare's ranges instead. -->
<clickhouse>
  <http_port>8123</http_port>
  <tcp_port>9000</tcp_port>
  <!-- Nothing here speaks MySQL, PostgreSQL or replication; the firewalls
       block these anyway, but a port that is not open cannot be misconfigured. -->
  <mysql_port remove="1"/>
  <postgresql_port remove="1"/>
  <interserver_http_port remove="1"/>
  <max_server_memory_usage_to_ram_ratio>0.7</max_server_memory_usage_to_ram_ratio>
  <mark_cache_size>268435456</mark_cache_size>
  <uncompressed_cache_size>0</uncompressed_cache_size>
  <!-- Background pools are left at their defaults: capping background_pool_size
       below the merge_tree free-entry thresholds (20 by default) stops the server
       from starting. -->
  <max_connections>256</max_connections>
  <max_concurrent_queries>16</max_concurrent_queries>
  <query_log><ttl>event_date + INTERVAL 14 DAY</ttl></query_log>
  <trace_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <part_log remove="1"/>
  <text_log remove="1"/>
  <processors_profile_log remove="1"/>
</clickhouse>
