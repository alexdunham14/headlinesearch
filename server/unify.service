[Unit]
Description=Build unified.headlines (GDELT, the news feeds and the blogs together; the proof of concept)
After=clickhouse-server.service
[Service]
Type=oneshot
User=headlines
EnvironmentFile=/var/lib/headlines/env
Environment=UNIFY_LOCK=/var/lib/headlines/unify.lock
WorkingDirectory=/opt/headlinesearch-unify
ExecStart=/opt/headlinesearch-unify/scripts/unify.py run
Nice=10
