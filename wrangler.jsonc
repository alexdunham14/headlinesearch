{
  "name": "headlinesearch",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": ".", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "SEARCH_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ]
}
