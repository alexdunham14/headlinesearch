<!-- Server settings for a small box (4 to 8 GB). Installed by setup.sh as
     /etc/clickhouse-server/config.d/headlinesearch.xml. Which interfaces the
     server listens on is in config.d/listen.xml, which setup.sh writes:
     localhost only behind the Tunnel, every interface when port 8123 is
     open to Cloudflare's ranges instead. -->
<clickhouse>
  <http_port>8123</http_port>
  <tcp_port>9000</tcp_port>
  <!-- Nothing here speaks MySQL, PostgreSQL or replication; the firewalls
       block these anyway, but a port that is not open cannot be misconfigured. -->
  <mysql_port remove="1"/>
  <postgresql_port remove="1"/>
  <interserver_http_port remove="1"/>
  <max_server_memory_usage_to_ram_ratio>0.7</max_server_memory_usage_to_ram_ratio>
  <mark_cache_size>268435456</mark_cache_size>
  <uncompressed_cache_size>0</uncompressed_cache_size>
  <!-- Background pools are left at their defaults: capping background_pool_size
       below the merge_tree free-entry thresholds (20 by default) stops the server
       from starting. -->
  <max_connections>256</max_connections>
  <max_concurrent_queries>16</max_concurrent_queries>
  <!-- The server log at information, not the package's trace: trace and
       debug were over 99% of its lines (every part read, merge and insert).
       Trace also held the one line per Worker request with the search words
       (DynamicQueryHandler's "Request URI"), and a per-logger level cannot
       keep it, since the file channel drops whatever is under its own level
       (tried 2026-09-16). query_log keeps the words instead (the query text
       with the parameters substituted), for 30 days rather than 14: about
       as far back as the rotated trace files reached. A change to the TTL
       here needs the same ALTER TABLE system.query_log MODIFY TTL on the
       running server, or a restart renames the old table to query_log_0;
       run it with SETTINGS materialize_ttl_after_modify = 0 (rewriting the
       table's TTL ran out of memory on this box, and a TTL merge reads the
       table's current TTL anyway).
       Since 2026-09-16: Alex chose the quieter log with the search record
       kept. -->
  <logger>
    <level>information</level>
  </logger>
  <query_log><ttl>event_date + INTERVAL 30 DAY</ttl></query_log>
  <trace_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <part_log remove="1"/>
  <text_log remove="1"/>
  <processors_profile_log remove="1"/>
</clickhouse>
